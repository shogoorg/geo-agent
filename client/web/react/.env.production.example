# Google Maps Platform API Key (used for loading Google Maps JS API and Place cards)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Backend A2A Endpoint URL (Cloud Run service URL + /a2a/app)
VITE_A2A_SERVER_URL=https://your-geo-agent-backend-url.run.app/a2a/app
SERVER_URL=https://your-geo-agent-backend-url.run.app/a2a/app
